# ---------------------------------------------------------------------------
# All values are OPTIONAL. The site builds and deploys fine with none of them.
# Copy to .env.local for local development, and add them in Vercel for prod.
# ---------------------------------------------------------------------------

# Canonical site URL (used for metadata, sitemap, robots, OG images).
NEXT_PUBLIC_SITE_URL=https://your-domain.com


# --- Contact form email (Resend) - REQUIRED for the form to send ----------
# The form posts to /api/contact, which needs this key to deliver mail.
# Without it the form falls back to opening the visitor's mail app.
#
#   1. Sign up at https://resend.com with the inbox you want messages in
#      (nikitakaushal98@gmail.com) — free tier, no card.
#   2. API Keys -> Create API Key -> copy it here (starts with re_).
#   3. Add the same key in Vercel: Project -> Settings -> Environment Variables.
#   4. Redeploy (env vars only apply to new builds).
#   5. Done — the form now emails you directly, no mail app involved.
#
# SERVER-ONLY. No NEXT_PUBLIC_ prefix, so it never reaches the browser.
RESEND_API_KEY=

# Where messages are delivered. Defaults to siteConfig.email.
CONTACT_TO_EMAIL=

# Sender address. The default shared sender needs no domain setup, but only
# delivers to the address that owns the Resend account. Verify your own domain
# in Resend to send from something like "Portfolio <hello@your-domain.com>".
CONTACT_FROM_EMAIL=


# --- Where the form posts (optional override) ------------------------------
# Leave empty: the form uses /api/contact + RESEND_API_KEY above (the default).
# Or point at Formspree / Web3Forms / Basin - same { name, email, message } JSON.
NEXT_PUBLIC_FORM_ENDPOINT=


# --- GitHub section (optional) ---------------------------------------------
# SERVER-ONLY. Raises the GitHub REST rate limit for the live repo/profile
# fetch, which only runs when data/github.ts has live: true.
GITHUB_TOKEN=
